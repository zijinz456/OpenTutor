+    Wait-NativeUrl 'http://127.0.0.1:3001' 90
+    Write-Output 'OpenTutor 已通过 Windows 原生方式启动：http://localhost:3001'
+    if (-not $NoBrowser) { Start-Process 'http://localhost:3001' }
+} catch {
+    Write-Error $_
+    exit 1
+}
+
+} finally {
+    if ($nativeLocked) { $nativeGate.ReleaseMutex() }
+    $nativeGate.Dispose()
+}
